# ###Delete a Key
raffle = {223842: "Teddy Bear", 872921: "Concert Tickets", 320291: "Gift Basket", 412123: "Necklace", 298787: "Pasta Maker"}#Crea diccionario numerico de un sorteo con los premios
print(raffle.pop(320291, "No Prize"))#Elimina la llave 320291, imprime el premio y si no existe imprime "No Prize"
print(raffle)#Imprime el diccionario resultante sin el premio recien eliminado
print(raffle.pop(100000, "No Prize"))#Intenta eliminar una llave que no existe y al fallar retorna "No Prize"
print(raffle)#Imprime el diccionario intacto ya que no se elimino nada
print(raffle.pop(872921, "No Prize"))#Elimina la llave 872921 y retorna cual era su respectivo premio
print(raffle)#Imprime el diccionario ya con las dos eliminaciones totales

