num_exercises = {"functions": 10, "syntax": 13, "control flow": 15, "loops": 22, "lists": 19, "classes": 18, "dictionaries": 18}#Crea diccionario de cantidad de ejercicios

total_exercises = 0#Inicializa el contador para la suma de ejercicios en 0

for exercises in num_exercises.values():#Inicia ciclo recorriendo unicamente los valores numericos del diccionario
  total_exercises += exercises#Suma cada valor numerico extraido al contador total
print(total_exercises)#Imprime la sumatoria total final de todos los ejercicios de todos los temas

# ##Get All Items
biggest_brands = {"Apple": 184, "Google": 141.7, "Microsoft": 80, "Coca-Cola": 69.7, "Amazon": 64.8}#Crea diccionario de grandes marcas y su valor estimado

for company, value in biggest_brands.items():#Recorre el diccionario extrayendo tanto la llave como el valor en simultaneo
 print(company + " has a value of " + str(value) + " billion dollars. ")#Imprime una oracion completa concatenando la llave (marca) y el valor numerico

pct_women_in_occupation = {"CEO": 28, "Engineering Manager": 9, "Pharmacist": 58, "Physician": 40, "Lawyer": 37, "Aerospace Engineer": 9}#Crea diccionario de profesiones y el respectivo porcentaje

