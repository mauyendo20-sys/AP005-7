# ##Get All Values
test_scores = {"Grace":[80, 72, 90], "Jeffrey":[88, 68, 81], "Sylvia":[80, 82, 84], "Pedro":[98, 96, 95], "Martin":[78, 80, 78], "Dina":[64, 60, 75]}#Crea de nuevo el diccionario de notas

for score_list in test_scores.values():#Inicia un ciclo que recorre unicamente los valores sin importar la llave
