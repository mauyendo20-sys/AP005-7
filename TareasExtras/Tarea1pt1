#################TUPLAS####################
###########################################
# Corresponde a una estructura similar a las listas, la diferencia esta
# en que no se pueden modificar una vez creadas, es decir que son inmutables:

#Convertir una lista a tupla:
print("###########################")#Escribe lo que esta entre comillas
print("###########################")#Escribe lo que esta entre comillas
print("###########################")#Escribe lo que esta entre comillas
print("############TUPLAS#########")#Escribe lo que esta entre comillas
my_tupla = tuple(my_lista)#Crea la anterior lista protegida
print()#Espacio
print()#Espacio
print("my_tuple: ", my_tupla)#Escribe my tupla y al frente la lista protegida

print(my_tupla[0])#Escribe el valor 0 que era rojo
print(my_tupla[2])#Escribe el valor 2 que era amarillo

#Evaluar si un elemento esta contenido en la tupla (Devuelve un valor booleano)
print('Rojo' in my_tupla)#Como si esta escribe True
print(my_tupla.count('Rojo'))#Imprime cuantas veces se repite el color rojo

#Tupla con un solo elemento
my_tupla_unitaria = ('Blanco')#Asigna una variable a un valor Blanco
print(my_tupla_unitaria)#Imprime Blanco

#Empaquetado de tupla, tupla sin parentesis
my_tupla = 'Gaspar', 5, 8, 1999#Crea una tupla a pesar de no poner los parentesis
print(my_tupla)#Imprime los 4 elementos

#Desempaquetado de tupla, se guardan los valores en orden de las variables
nombre, dia, mes, año = my_tupla#Encapsula cada uno de los elementos y los pone en una variable independiente
print(nombre)#Escribe Gaspar
print(dia)#Escribe 5
print(mes)#Escribe 8
print(año)#Escribe 1999

print("Nombre: ", nombre, " - Dia:", dia, " - Mes: ", mes, "- Año: ", año)#Escribe ordenamente los anteriores elementos

#Convertir una tupla en una lista
my_lista2=list(my_tupla)#Convierte my_tupla en una lista
print(my_lista2)#Imprime la lista
