###Dict Comprehensions
names = ['Jenny', 'Alexus', 'Sam', 'Grace']#Crea una lista de nombres
heights = [61, 70, 67, 64]#Crea una lista de estaturas

songs = ["Like a Rolling Stone", "Satisfaction", "Imagine", "What's Going On", "Respect", "Good Vibrations"]#Crea una lista de canciones
playcounts = [78, 29, 44, 21, 89, 5]#Crea una lista de reproducciones
plays = {key:value for key, value in zip(songs, playcounts)}#Crea un diccionario uniendo ambas listas (canciones como llaves y reproducciones como valores)
print(plays)#Imprime el diccionario creado a partir del emparejamiento
plays.update({"Purple Haze": 1})#Agrega una nueva cancion al diccionario general
plays.update({"Respect": 94})#Actualiza el valor de reproducciones de la cancion "Respect" que ya existia
print("After: ", plays)#Imprime el diccionario con la nueva cancion y el valor actualizado

library = {"The Best Songs": plays, "Sunday Feelings": {}}#Crea un diccionario anidado donde un valor es el diccionario anterior y el otro esta vacio
print(library)#Imprime el diccionario principal que contiene al otro por dentro
