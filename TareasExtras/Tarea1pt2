## Overwrite Values ##
menu = {"oatmeal": 3, "avocado toast": 6, "carrot juice": 5, "blueberry muffin": 2}#Crea el diccionario de menu original
print("Before: ", menu)#Imprime el menu inicial
menu["oatmeal"] = 5#Modifica el valor del elemento existente "oatmeal" pasandolo a 5
