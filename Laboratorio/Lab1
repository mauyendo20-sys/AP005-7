const int led = 4;

void setup() {
  pinMode(led, OUTPUT);
  Serial.begin(115200); 

  digitalWrite(led, HIGH);
  Serial.println("LED prendido");
  delay(1000);
  digitalWrite(led, LOW);
  Serial.println("LED apagado");
  delay(1000);

  digitalWrite(led, HIGH);
  Serial.println("LED prendido");
  delay(1000);
  digitalWrite(led, LOW);
  Serial.println("LED apagado");
  delay(1000);

  digitalWrite(led, HIGH);
  Serial.println("LED prendido");
  delay(1000);
  digitalWrite(led, LOW);
  Serial.println("LED apagado");
  delay(50);
}

void loop() {
}
